#!/bin/sh
# MINT's default launcher uses the native C runtime. Python is not invoked.
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
RUNTIME="$ROOT/bin/mint"
SOURCE="$ROOT/runtime/mint.c"
if [ ! -x "$RUNTIME" ] || [ "$SOURCE" -nt "$RUNTIME" ]; then
    CC_BIN="$(command -v cc || command -v gcc || command -v clang)"
    if [ -z "$CC_BIN" ]; then
        echo "MINT: native runtime is not built. Run ./setup.sh (or install a C compiler, e.g. sudo apt install build-essential)." >&2
        exit 1
    fi
    mkdir -p "$ROOT/bin"
    DEFINES=""
    LIBS="-lm"
    EXTRA_CFLAGS=""
    if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists sqlite3; then
        DEFINES="$DEFINES -DMINT_WITH_SQLITE"
        SQLITE_FLAGS="$(pkg-config --cflags --libs sqlite3)"
        LIBS="$LIBS $SQLITE_FLAGS"
    fi
    if [ -f "$ROOT/third_party/raylib/src/libraylib.a" ] && [ -f "$ROOT/third_party/raylib/src/raylib.h" ]; then
        DEFINES="$DEFINES -DMINT_WITH_RAYLIB"
        EXTRA_CFLAGS="-I$ROOT/third_party/raylib/src"
        LIBS="$LIBS $ROOT/third_party/raylib/src/libraylib.a -lGL -lpthread -ldl -lrt -lX11"
    elif command -v pkg-config >/dev/null 2>&1 && pkg-config --exists raylib; then
        DEFINES="$DEFINES -DMINT_WITH_RAYLIB"
        EXTRA_CFLAGS="$(pkg-config --cflags raylib)"
        RAYLIB_LIBS="$(pkg-config --libs raylib)"
        LIBS="$LIBS $RAYLIB_LIBS"
    fi
    # shellcheck disable=SC2086
    "$CC_BIN" -std=c11 -O2 $DEFINES $EXTRA_CFLAGS "$SOURCE" $LIBS -o "$RUNTIME" || exit $?
    chmod +x "$RUNTIME"
fi
exec "$RUNTIME" "$@"
